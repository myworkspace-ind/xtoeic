        <sakai.slf4j.version>1.7.36</sakai.slf4j.version>
        <sakai.poi.version>5.4.1</sakai.poi.version>
        <sakai.jackson.version>2.17.2</sakai.jackson.version>
        <javacommon.version>0.7.2</javacommon.version>
        <sakai.weld.shaded.version>3.1.9.Final</sakai.weld.shaded.version>
